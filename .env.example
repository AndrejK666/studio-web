# Copy to `.env` next to docker-compose.yml — compose reads it automatically.
# Everything here is optional: an empty value turns the matching feature off
# with a clear message instead of breaking the stack.

# Postgres superuser password for the bundled database.
STUDIO_PG_PASSWORD=studio

# OpenAI-compatible key for Ask AI (mini-chat). The default profile points at
# Groq's free tier (console.groq.com -> API Keys, no card).
# The IDE's agents (Claude Code, Codex) and its chat take no key from here:
# each person adds their own Anthropic/OpenAI key to their Studio profile, or
# an owner connects one for a workspace under Connections.
STUDIO_LLM_API_KEY=

# Encryption key for credstore secret values at rest (32 bytes, base64).
# THIS one is not optional in spirit: without it secret values do not survive
# `docker compose restart backend` — the backend logs a warning, falls back to
# the in-memory value store, and any PAT or connector token entered in the
# portal is gone. Generate it once and keep it; a new key makes previously
# stored values unreadable (they read as absent and must be entered again).
#   openssl rand -base64 32
STUDIO_CREDSTORE_KEY=

# ghcr credentials for pulling the Theia session image. A classic PAT with
# read:packages — an account password will not do.
STUDIO_REGISTRY_USER=
STUDIO_REGISTRY_TOKEN=

# External spec-quality detector service (studio-spec-quality gear).
# The service authenticates with its own shared bearer secret — set it here so
# the backend can call it; it never reaches the browser. Leave blank to keep
# analysis off. Optionally override the upstream base URL (a config default exists).
STUDIO_SPEC_QUALITY_API_KEY=
#STUDIO_SPEC_QUALITY_BASE_URL=https://349ddd50986c491c844d92fdaefcadfe.constructor.pro

# The spec-graph service (studio-spec-graph, the Spec graph kit): its address,
# its API key (nsq_…, scopes read and run), and the address at which the service
# reaches this backend's gateway (it clones projects' sources through the Git
# proxy there). Leave blank to keep the integration off.
STUDIO_SPEC_GRAPH_URL=
STUDIO_SPEC_GRAPH_SECRET=
#STUDIO_SPEC_GRAPH_GIT_URL=http://host.docker.internal:8090/cf

# Constructor Insight — read-only analytics over its ClickHouse warehouse
# (studio-insight gear -> POST /cf/studio-insight/v1/query). The value is an
# Insight INSTANCE TOKEN, sent as a bearer; it never reaches the browser. Leave
# blank to keep the integration off (calls answer 503, health says
# configured=false). The host is in config/*.yaml — set the variable below only
# to point at another deployment.
STUDIO_INSIGHT_API_KEY=
#STUDIO_INSIGHT_BASE_URL=https://insight.cfabric.org

# Signing in to Studio with a Constructor IdP account: the realm's
# `constructor` broker (keycloak/CONSTRUCTOR_SSO.md). Unset, it brokers the
# Research emulator's IdP (http://research.localhost:8095/idp, any email signs
# in). Set the issuer to nothing to switch the broker off. A real IdP must list
# https://localhost:8443/realms/studio/broker/constructor/endpoint among the
# client's redirect URIs; Constructor DEV's does not (yet).
#STUDIO_CONSTRUCTOR_IDP_ISSUER=https://dev-constructor.dev/idp
#STUDIO_CONSTRUCTOR_IDP_CLIENT_ID=constructor-studio
#STUDIO_CONSTRUCTOR_IDP_CLIENT_SECRET=
