# Copy to `.env` next to docker-compose.yml — compose reads it automatically.
# Everything here is optional: an empty value turns the matching feature off
# with a clear message instead of breaking the stack.

# Postgres superuser password for the bundled database.
STUDIO_PG_PASSWORD=studio

# OpenAI-compatible key for Ask AI, mini-chat and the Codex agent. The default
# profile points at Groq's free tier (console.groq.com -> API Keys, no card).
STUDIO_LLM_API_KEY=

# Anthropic key for the Claude Code agent inside IDE sessions. Not
# OpenAI-compatible: the agent talks to Anthropic directly, never through
# studio-llm-proxy.
STUDIO_ANTHROPIC_API_KEY=

# ghcr credentials for pulling the Theia session image. A classic PAT with
# read:packages — an account password will not do.
STUDIO_REGISTRY_USER=
STUDIO_REGISTRY_TOKEN=
