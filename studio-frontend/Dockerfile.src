# syntax=docker/dockerfile:1.7
# Build the Studio frontend FROM SOURCE (one-click compose path).
# Context = CFS root (matches the backend's Dockerfile.src).
# CI uses ./Dockerfile with a prebuilt dist/ instead.

FROM node:22-alpine AS build
WORKDIR /src
COPY studio-web/studio-frontend/package.json studio-web/studio-frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY studio-web/studio-frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY studio-web/studio-frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/ /usr/share/nginx/html/
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1
