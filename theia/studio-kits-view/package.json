{
  "name": "studio-kits-view",
  "keywords": [
    "theia-extension"
  ],
  "version": "0.1.0",
  "private": true,
  "description": "Studio kits in the desktop's Extensions view: installed in the open project, recommended, and found by search.",
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/vsx-registry": "1.75.0",
    "@theia/workspace": "1.75.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.4.5"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/studio-kits-frontend-module"
    }
  ],
  "scripts": {
    "prepare": "npm run clean && npm run build",
    "clean": "rimraf lib",
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "jest --config configs/jest.config.js"
  }
}
