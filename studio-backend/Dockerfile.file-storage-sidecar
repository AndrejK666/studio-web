# Runtime image for the file-storage data plane.
# studio-delivery.yml builds the binary from the cf-gears-file-storage release
# pinned in studio-backend/Cargo.lock (`cargo install --locked`) and places it
# in .release/file-storage-sidecar.
FROM debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1000 studio \
 && useradd --system --uid 1000 --gid 1000 --home /app studio

WORKDIR /app
COPY .release/file-storage-sidecar /app/file-storage-sidecar
RUN chmod +x /app/file-storage-sidecar && chown -R studio:studio /app

USER 1000
EXPOSE 8087
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD curl -sf http://127.0.0.1:8087/healthz || exit 1

ENTRYPOINT ["/app/file-storage-sidecar"]
