# Kubernetes Connector Plugin: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/environments/plugins/kubernetes/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Kubernetes Connector Plugin",
    description = "The delivery kit's Kubernetes driver, registered under studio-connector's connector plugin point (ADR-0079).",
    category = "core-platform-integration",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../../../..",
        attr = "src/environments/plugins/kubernetes/mod.rs",
    ),
    implements = "cf.studio.connector.plugin.v1~",
    # The vendor studio-connector selects drivers by, and the priority among
    # drivers of one vendor.
    config_schema = config(rust = "Config", exposes = ["vendor", "priority"]),
)
