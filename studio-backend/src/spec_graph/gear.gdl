# Studio Spec Graph: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/spec_graph/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Spec Graph",
    description = "A project's documents as a typed graph, checked by deterministic rules and judged by models, through the external spec-graph service.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/spec_graph/mod.rs",
    ),
)
