{
  "manifest_version": "1",
  "slug": "org-costs",
  "icon": "lucide:wallet",
  "name": "Costs",
  "description": "What an organization's model calls and IDE sessions cost, its price list and monthly budgets.",
  "publisher": "Constructor Fabric",
  "levels": [
    "organization"
  ],
  "screens": [
    {
      "kind": "tab",
      "level": "organization",
      "label": "Costs",
      "route": "/costs",
      "mfe": "costs-mfe"
    }
  ],
  "model": {
    "properties": [
      {
        "on": "organization",
        "property": {
          "name": "costs",
          "type": "budget",
          "relation": "budget",
          "extends": "edge",
          "relationType": "shows",
          "relationLabel": "Costs",
          "description": "A tab of the organization: what it shows."
        }
      }
    ]
  },
  "permissions": {
    "reads": [
      "GET /studio-usage/v1/costs",
      "GET /studio-usage/v1/prices",
      "GET /studio-usage/v1/budgets",
      "GET /studio-usage/v1/budget-status"
    ],
    "writes": [
      "PUT /studio-usage/v1/budgets",
      "PUT /studio-usage/v1/prices"
    ]
  },
  "gears": [
    {
      "gear": "studio-usage",
      "types": [
        "budget",
        "model-price"
      ],
      "routes": [
        "PUT /studio-usage/v1/budgets",
        "PUT /studio-usage/v1/prices"
      ]
    }
  ]
}
