{
  "manifest_version": "1",
  "slug": "constructor-research",
  "icon": "lucide:atom",
  "name": "Constructor Research",
  "description": "Build a project's product in Constructor Research and run it there as one of its applications.",
  "publisher": "Constructor Fabric",
  "levels": [
    "organization",
    "project"
  ],
  "screens": [
    {
      "kind": "tab",
      "level": "organization",
      "label": "Constructor Research",
      "route": "/constructor-research",
      "mfe": "infrastructure-mfe"
    }
  ],
  "requires": [
    "delivery"
  ],
  "inbox": [
    {
      "id": "deploy-failed",
      "label": "A Research deploy you asked for failed",
      "kind": "endpoint",
      "path": "/studio-environments/v1/research/inbox/deploys"
    },
    {
      "id": "sign-in-expires",
      "label": "Your Constructor Research sign-in runs out",
      "kind": "endpoint",
      "path": "/studio-environments/v1/research/inbox/sign-in"
    }
  ],
  "mcp_tools": [
    {
      "name": "research_projects",
      "description": "The Research projects a sign-in may run products in"
    },
    {
      "name": "research_hardware",
      "description": "The hardware a Research project's services may run on"
    }
  ],
  "permissions": {
    "reads": [
      "GET /studio-environments/v1/environments",
      "POST /studio-environments/v1/environments/{environment_id}/test",
      "GET /studio-environments/v1/research/projects",
      "GET /studio-environments/v1/research/projects/{project}/hardware",
      "GET /studio-environments/v1/research/my-projects",
      "GET /studio-environments/v1/research/my-projects/{research_project}/hardware",
      "GET /studio-environments/v1/deployments",
      "GET /studio-environments/v1/deployments/{deployment_id}",
      "GET /studio-environments/v1/deployments/{deployment_id}/status",
      "GET /studio-environments/v1/deployments/{deployment_id}/logs",
      "GET /studio-environments/v1/builds/{build_id}/log",
      "GET /studio-connector/v1/connections",
      "GET /studio-environments/v1/research/inbox/deploys",
      "GET /studio-environments/v1/research/inbox/sign-in"
    ],
    "writes": [
      "POST /studio-environments/v1/environments",
      "PUT /studio-environments/v1/environments/{environment_id}",
      "POST /studio-environments/v1/project-environments",
      "POST /studio-environments/v1/builds",
      "POST /studio-environments/v1/deployments"
    ]
  },
  "model": {
    "types": [
      {
        "name": "project",
        "extends": "project",
        "label": "Constructor Research project",
        "description": "A project whose product is built and run in Constructor Research, as one of its applications.",
        "fields": [
          {
            "name": "research_project",
            "type": "string?",
            "description": "The Research project the product runs in"
          },
          {
            "name": "research_hardware",
            "type": "string?",
            "description": "The hardware its services run on in that Research project"
          }
        ]
      }
    ]
  },
  "project_creation": {
    "mode": "greenfield",
    "steps": ["sources", "prd"],
    "next_steps": [
      {
        "id": "connect-research-project",
        "label": "Connect a Research project",
        "description": "Sign in to Constructor Research and connect the Research project the product runs in, with its hardware.",
        "route": "/constructor-research"
      },
      {
        "id": "build-and-run",
        "label": "Build and run it in Research",
        "description": "Build the product and deploy it to the Research project from Releases.",
        "route": "/releases",
        "done_when": "build"
      }
    ]
  },
  "gears": [
    {
      "gear": "studio-environments",
      "mcp_tools": [
        "research_projects",
        "research_hardware"
      ]
    }
  ]
}
