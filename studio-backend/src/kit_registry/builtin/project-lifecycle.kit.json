      {
        "on": "workspace",
        "property": {
          "name": "ptypes",
          "type": "project-type",
          "relation": "project-type",
          "extends": "edge",
          "relationType": "shows",
          "relationLabel": "Templates & phases",
          "description": "A tab of the workspace: what it shows."
        }
      }
    ]
  },
  "inbox": [
    {
      "id": "phase-waiting",
      "label": "A project waiting in its phase on its owner",
      "query": {
        "type": "project",
        "where": {
          "_and": [
            {
              "phase_owner": {
                "_eq": "$me"
              }
            },
            {
              "phase": {
                "_in": [
                  "idea",
                  "discovery",
                  "build"
                ]
              }
            }
          ]
        },
        "fields": [
          "name",
          "tenant_id",
          "parent_tenant_id",
          "phase",
          "phase_owner",
          "phase_since"
        ],
        "order_by": [
          {
            "field": "phase_since"
          }
        ],
        "limit": 200
      },
      "title": "{name} waits in its {phase} phase",
      "workspace_field": "parent_tenant_id"
    }
  ],
  "mcp_tools": [
    {
      "name": "project_phase",
      "description": "A project's phase, its owner and the phases it may move to"
    },
    {
      "name": "project_phase_set",
      "description": "Move a project to a phase along the declared lifecycle"
    }
  ],
  "permissions": {
    "reads": [
      "GET /studio-kits/v1/project-phase",
      "GET /studio-kits/v1/project-phases"
    ],
    "writes": [
      "PUT /studio-kits/v1/project-phase"
    ]
  }
}
