    "tabs": [
      {
        "level": "project",
        "name": "phases",
        "label": "Phases",
        "target": "phase"
      }
    ],
    "lifecycles": [
      {
        "on": "project",
        "field": "phase",
        "states": [
          "idea",
          "discovery",
          "build",
          "run"
        ],
        "initial": "idea",
        "transitions": [
          {
            "name": "discover",
            "from": [
              "idea"
            ],
            "to": "discovery"
          },
          {
            "name": "build",
            "from": [
              "discovery"
            ],
            "to": "build"
          },
          {
            "name": "launch",
            "from": [
              "build"
            ],
            "to": "run"
          },
          {
            "name": "rethink",
            "from": [
              "discovery",
              "build"
            ],
            "to": "idea"
          },
          {
            "name": "rework",
            "from": [
              "run"
            ],
            "to": "build"
          }
        ]
      }
    ],
    "properties": [
      {
        "on": "project",
        "property": {
          "name": "tracks",
          "type": "Risk",
          "description": "",
          "relation": "risk",
          "relationType": "composes",
          "relationLabel": "tracks",
          "required": false,
          "extends": "edge"
        }
