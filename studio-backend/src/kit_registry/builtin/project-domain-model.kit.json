            "relationship": "control-loop",
            "priority": "P2",
            "level": 4,
            "badge": "From MaxV",
            "note": "Added as the generic observed graph issue and signal object. · model.md §6.1",
            "badge-style": "green",
            "profiles": [
              "Arch",
              "Dev",
              "QA",
              "Sec",
              "StudioAdmin"
            ],
            "links": [
              {
                "kind": "see-also",
                "target": "security-finding",
                "note": "Kit specialization of the generic Finding; renamed to Security Finding to clear the name collision"
              }
            ]
          },
          "properties": [
            {
              "name": "id",
              "type": "FindingId",
              "required": true,
              "description": "",
              "relationLabel": "",
              "override": true
            },
            {
              "name": "title",
              "type": "string",
              "required": true,
              "description": "",
              "relationLabel": "",
              "override": true
            },
            {
              "name": "finding_kind",
              "type": "gap | drift | stale | contradiction | duplicate | ownership_hole | review | scan | cost_optimization | bloat",
              "required": true,
              "description": "",
              "relationLabel": ""
            },
            {
              "name": "provenance_kind",
              "type": "mirrored | computed | authored",
              "required": true,
              "description": "",
              "relationLabel": ""
            },
            {
              "name": "subject_refs",
              "type": "EntityRef[]",
              "description": "",
              "relationLabel": ""
            },
            {
              "name": "status",
              "type": "detected | acknowledged | triaged | accepted | dismissed | auto_resolved",
              "required": true,
              "description": "",
              "relationLabel": ""
            },
            {
              "name": "provenance_ref",
              "type": "ProvenanceId?",
              "description": "",
              "relationLabel": "",
              "override": true
            },
            {
              "name": "may_produce",
              "type": "ActionRun",
              "description": "",
              "relation": "action-run",
              "relationType": "derives",
              "relationLabel": "may produce",
              "required": false,
              "cardinality": "1:N",
              "extends": "link"
            },
            {
              "name": "may_produce_opportunity",
              "type": "ManagedObject",
              "description": "",
              "relation": "managed-object",
              "relationType": "derives",
              "relationLabel": "may produce opportunity",
              "required": false,
              "extends": "edge"
            },
            {
              "name": "accepted_as",
              "type": "Opportunity",
              "description": "",
              "relation": "opportunity",
              "relationType": "derives",
              "relationLabel": "accepted as",
              "required": false,
              "extends": "edge"
