{
  "manifest_version": "1",
  "slug": "project-domain-model",
  "icon": "lucide:shapes",
  "name": "Project domain model",
  "description": "What a project's documents say the application is, and the issues they leave to decide (not the Studio domain model).",
  "publisher": "Constructor Fabric",
  "levels": [
    "project"
  ],
  "requires": [
    "project-specs"
  ],
  "model": {
    "properties": [
      {
        "on": "project",
        "property": {
          "name": "model",
          "type": "object-type",
          "relation": "object-type",
          "extends": "edge",
          "relationType": "shows",
          "relationLabel": "Domain model",
          "description": "A tab of the project: what it shows."
        }
      },
      {
        "on": "project",
        "property": {
          "name": "issues",
          "type": "finding",
          "relation": "finding",
          "extends": "edge",
          "relationType": "shows",
          "relationLabel": "Issues",
          "description": "A tab of the project: what it shows."
        }
      },
      {
        "on": "kit",
        "property": {
          "name": "introduces_type_22",
          "type": "Finding",
          "description": "",
          "relation": "security-finding",
          "relationType": "references",
          "relationLabel": "packages",
          "required": false,
          "extends": "link"
        }
      }
    ],
    "types": [
      {
        "name": "finding",
        "id": "finding",
        "label": "Finding",
        "description": "Observed issue over the graph: gap, drift, staleness, contradiction, duplicate, ownership hole or review/scan result.",
