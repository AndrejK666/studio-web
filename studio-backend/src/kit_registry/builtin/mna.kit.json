{
  "manifest_version": "1",
  "slug": "mna",
  "icon": "lucide:handshake",
  "name": "M&A due diligence",
  "description": "Technical due diligence of an acquisition target: the deal as a project, the target's repositories as its sources, findings, risks and open questions, the evidence Studio already holds, and a recommendation the deal lead signs off.",
  "publisher": "Constructor Fabric",
  "levels": [
    "project"
  ],
  "screens": [
    {
      "kind": "tab",
      "level": "project",
      "label": "Deal",
      "route": "/deal",
      "mfe": "mna-mfe"
    }
  ],
  "project_type": true,
  "model": {
    "types": [
      {
        "name": "project",
        "extends": "project",
        "label": "M&A deal",
        "description": "A project that evaluates a target company's software before an acquisition: whether to proceed, on what conditions.",
        "fields": [
          {
            "name": "target",
            "type": "string?",
            "description": "The company being evaluated"
          },
          {
            "name": "thesis",
            "type": "string?",
            "description": "The strategic thesis: why the acquisition, and what the technology must hold up"
          },
          {
            "name": "deal_phase",
            "type": "screening | confirmatory_dd | signing | integration",
            "description": "Where the deal stands"
          },
          {
            "name": "ic_date",
            "type": "date?",
            "description": "When the investment committee decides"
          },
          {
            "name": "recommendation",
            "type": "proceed | proceed_with_conditions | stop",
            "description": "The technical recommendation to the committee"
          },
          {
            "name": "conditions",
            "type": "string[]",
            "description": "The conditions the recommendation sets"
          },
          {
            "name": "signed_off_by",
            "type": "string?",
            "description": "The deal lead who signed the recommendation off (a subject id)"
          },
          {
            "name": "signed_off_at",
            "type": "timestamp?",
            "description": "When the recommendation was signed off"
          }
        ]
      },
      {
        "name": "finding",
        "label": "Finding",
        "description": "Something the due diligence found in the target's software, with its severity, what it is about and its evidence.",
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true,
            "description": "What was found"
          },
          {
            "name": "severity",
            "type": "critical | high | medium | low | info",
            "required": true,
            "description": "How much it weighs on the deal"
          },
          {
            "name": "source",
            "type": "string?",
            "description": "The repository or part of the target it is about"
          },
          {
            "name": "evidence",
            "type": "string?",
            "description": "What shows it: a link, a measurement, a quote"
          },
          {
            "name": "origin",
            "type": "string",
            "description": "Where it came from: manual, spec_check, ci, git, interview"
          },
          {
            "name": "status",
            "type": "open | accepted | resolved",
            "description": "Whether it is still open"
          }
        ]
      },
      {
        "name": "risk",
        "label": "Deal risk",
        "description": "An entry of the deal's risk ledger: likelihood, impact, owner and mitigation, and the finding it comes from.",
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true,
            "description": "The risk"
          },
          {
            "name": "likelihood",
            "type": "low | medium | high",
            "required": true,
            "description": "How likely it is"
          },
          {
            "name": "impact",
            "type": "low | medium | high | critical",
            "required": true,
            "description": "How badly it would hit"
          },
          {
            "name": "owner",
            "type": "string?",
            "description": "Who owns it"
          },
          {
            "name": "mitigation",
            "type": "string?",
            "description": "What is done about it"
          },
          {
            "name": "finding_id",
            "type": "string?",
            "description": "The finding it comes from"
          },
          {
            "name": "status",
            "type": "open | mitigating | accepted | closed",
            "description": "Where it stands"
          }
        ]
      },
      {
        "name": "open-question",
        "label": "Open question",
        "description": "A question the deal team asks the target: who answers it, what it is, and the answer.",
        "fields": [
          {
            "name": "what",
            "type": "string",
            "required": true,
            "description": "The question"
          },
          {
            "name": "who",
            "type": "string?",
            "description": "Who is asked"
          },
          {
            "name": "answer",
            "type": "string?",
            "description": "The answer"
          },
          {
            "name": "status",
            "type": "open | answered | closed",
            "description": "Whether it is answered"
          }
        ]
      }
    ],
    "relations": [
      {
        "on": "finding",
        "name": "about",
        "target": "project",
        "label": "about the deal"
      },
      {
        "on": "risk",
        "name": "about",
        "target": "project",
        "label": "in the deal's ledger"
      },
      {
        "on": "risk",
        "name": "from_finding",
        "target": "finding",
        "label": "comes from"
      },
      {
        "on": "open-question",
        "name": "about",
        "target": "project",
        "label": "asked in the deal"
      }
    ]
  },
  "project_creation": {
    "mode": "modernize",
    "steps": [
      "sources"
    ],
    "next_steps": [
      {
        "id": "connect-target-repositories",
        "label": "Connect the target's repositories",
        "description": "Attach the target's repositories, read-only, through a connection that reaches them. Studio reads its evidence from them.",
        "route": "/projects/sources",
        "done_when": "repos"
      },
      {
        "id": "fill-in-thesis",
        "label": "Fill in the thesis",
        "description": "Say why the acquisition, and what the target's technology has to hold up.",
        "route": "/deal",
        "done_when": "field:thesis"
      },
      {
        "id": "review-evidence",
        "label": "Review the evidence",
        "description": "See what Studio already knows of the target: repositories, contributors and truck factor, CI and specs. Record findings and risks from it.",
        "route": "/deal"
      }
    ]
  },
  "mcp_tools": [
    {
      "name": "mna_deal",
      "description": "A deal's attributes, its recommendation and sign-off, and its evidence summary"
    },
    {
      "name": "mna_deal_update",
      "description": "Change a deal's target, thesis, phase, IC date, recommendation or conditions, or sign the recommendation off"
    },
    {
      "name": "mna_findings",
      "description": "A deal's findings"
    },
    {
      "name": "mna_finding_upsert",
      "description": "Record or change a finding of a deal"
    },
    {
      "name": "mna_risks",
      "description": "A deal's risk ledger"
    },
    {
      "name": "mna_risk_upsert",
      "description": "Record or change a risk of a deal"
    }
  ],
  "permissions": {
    "reads": [
      "GET /studio-kits/v1/mna/deal",
      "GET /studio-kits/v1/mna/evidence",
      "GET /studio-kits/v1/mna/findings",
      "GET /studio-kits/v1/mna/risks",
      "GET /studio-kits/v1/mna/open-questions"
    ],
    "writes": [
      "PATCH /studio-kits/v1/mna/deal",
      "POST /studio-kits/v1/mna/deal/sign-off",
      "POST /studio-kits/v1/mna/findings",
      "PUT /studio-kits/v1/mna/findings/{finding_id}",
      "DELETE /studio-kits/v1/mna/findings/{finding_id}",
      "POST /studio-kits/v1/mna/risks",
      "PUT /studio-kits/v1/mna/risks/{risk_id}",
      "DELETE /studio-kits/v1/mna/risks/{risk_id}",
      "POST /studio-kits/v1/mna/open-questions",
      "PUT /studio-kits/v1/mna/open-questions/{question_id}",
      "DELETE /studio-kits/v1/mna/open-questions/{question_id}"
    ]
  },
  "gears": [
    {
      "gear": "studio-kits",
      "mcp_tools": [
        "mna_deal",
        "mna_deal_update",
        "mna_findings",
        "mna_finding_upsert",
        "mna_risks",
        "mna_risk_upsert"
      ],
      "routes": [
        "PATCH /studio-kits/v1/mna/deal",
        "POST /studio-kits/v1/mna/deal/sign-off",
        "POST /studio-kits/v1/mna/findings",
        "PUT /studio-kits/v1/mna/findings/{finding_id}",
        "DELETE /studio-kits/v1/mna/findings/{finding_id}",
        "POST /studio-kits/v1/mna/risks",
        "PUT /studio-kits/v1/mna/risks/{risk_id}",
        "DELETE /studio-kits/v1/mna/risks/{risk_id}",
        "POST /studio-kits/v1/mna/open-questions",
        "PUT /studio-kits/v1/mna/open-questions/{question_id}",
        "DELETE /studio-kits/v1/mna/open-questions/{question_id}"
      ]
    }
  ]
}
