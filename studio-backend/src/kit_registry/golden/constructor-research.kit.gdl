gdl_version = "1.7"

kit(
    slug = "constructor-research",
    name = "Constructor Research",
    version = "0.0.0-golden",
    description = "Build a project's product in Constructor Research and run it there as one of its applications: the Research projects, their hardware, and the deploys, rollbacks and addresses of what runs there. For the whole organization, or for one project.",
    publisher = "Constructor Fabric",
    icon = "lucide:atom",
    levels = ["organization", "project"],
    types = [
        kit_type(gts = "gts.cf.studio.domain.project.v1~cf.studio.kit_constructor_research.project.v1~", id = "constructor-research-project", name = "Constructor Research project", description = "A project whose product is built and run in Constructor Research, as one of its applications.", fields = [kit_field(name = "research_project", type = "string?", description = "The Research project the product runs in"), kit_field(name = "research_hardware", type = "string?", description = "The hardware its services run on in that Research project")]),
    ],
    model = path("model/overlay.json"),
    tabs = [
        kit_tab(level = "organization", label = "Constructor Research", route = "/constructor-research"),
    ],
    inbox = [
