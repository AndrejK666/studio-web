        kit_inbox_source(id = "sign-in-expires", label = "Your Constructor Research sign-in runs out"),
    ],
    mcp_tools = [
        "research_projects",
        "research_hardware",
    ],
    requires = [
        "delivery",
    ],
    gears = [
